DATABASE_URL=postgresql://presupuestos:presupuestos@localhost:5433/presupuestos
DATABASE_URL_TEST=postgresql://presupuestos:presupuestos@localhost:5433/presupuestos_test
BETTER_AUTH_SECRET=cambiar-por-32-caracteres-aleatorios
BETTER_AUTH_URL=http://localhost:3000
# Distinto en cada entorno que comparta IP; el valor por defecto conserva las sesiones existentes.
BETTER_AUTH_COOKIE_PREFIX=better-auth
DATA_DIR=./data

# Contenedor de PostgreSQL (compose.yaml). En producción, una contraseña larga y aleatoria.
POSTGRES_USER=presupuestos
POSTGRES_PASSWORD=presupuestos
POSTGRES_DB=presupuestos
